<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- URL Schemes: Meta AI アプリとのコールバック用 -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>https://kojiokazaki.github.io/dat-link/</string>
            </array>
            <key>CFBundleURLName</key>
            <string>com.cbt.mrbtest</string>
        </dict>
    </array>

    <!-- MWDAT: Meta Wearables Device Access Toolkit 設定 -->
    <key>MWDAT</key>
    <dict>
        <key>MetaAppID</key>
        <string>4225976931002254</string>
        <key>Analytics</key>
        <dict>
            <key>OptOut</key>
            <true/>
        </dict>
        <key>AppLinkURLScheme</key>
        <string>https://kojiokazaki.github.io/dat-link/</string>
    </dict>

    <!-- カメラ使用の説明 (Privacy) -->
    <key>NSCameraUsageDescription</key>
    <string>Ray-Ban Meta グラスのカメラストリームを受信するために使用します</string>

    <!-- Bluetooth 使用の説明 -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Ray-Ban Meta グラスと接続するために使用します</string>

    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>Ray-Ban Meta グラスと通信するために使用します</string>

    <!-- LSApplicationQueriesSchemes - Meta AI アプリを開くため -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>fb-metaai</string>
    </array>
</dict>
</plist>
