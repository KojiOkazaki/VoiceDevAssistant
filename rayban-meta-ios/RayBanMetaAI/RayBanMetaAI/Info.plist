<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Meta AI コールバックのカスタム URL スキームを構成する -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>raybanmetaai</string>
            </array>
            <key>CFBundleURLName</key>
            <string>com.example.raybanmetaai</string>
        </dict>
    </array>

    <!-- Meta AI アプリがこのアプリにコールバックできるようにする URL スキーム -->
    <key>LinkURLScheme</key>
    <string>raybanmetaai</string>

    <!-- Meta App ID - 開発者モードでは空文字列でOK -->
    <!-- 配布アプリの場合はウェアラブル開発者センターから取得した値を設定 -->
    <key>MetaAppID</key>
    <string></string>

    <!-- Meta Client Token (配布時に設定) -->
    <key>ClientToken</key>
    <string></string>

    <!-- Team ID (配布時に設定) -->
    <key>TeamID</key>
    <string></string>

    <!-- カメラ使用の説明 (Privacy) -->
    <key>NSCameraUsageDescription</key>
    <string>Ray-Ban Meta グラスのカメラストリームを受信するために使用します</string>

    <!-- Bluetooth 使用の説明 -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Ray-Ban Meta グラスと接続するために使用します</string>

    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>Ray-Ban Meta グラスと通信するために使用します</string>

    <!-- アプリの基本設定 -->
    <key>CFBundleDevelopmentRegion</key>
    <string>ja</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>bluetooth-le</string>
    </array>

    <!-- LSApplicationQueriesSchemes - Meta AI アプリを開くため -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>fb-metaai</string>
    </array>
</dict>
</plist>
