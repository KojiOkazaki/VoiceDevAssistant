<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 必須キー -->
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleDisplayName</key>
    <string>RayBan Meta AI</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>

    <!-- URL Schemes: Meta AI アプリとのコールバック用 -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>https://kojiokazaki.github.io/dat-link/</string>
            </array>
            <key>CFBundleURLName</key>
            <string>com.cbt.mrbtest</string>
        </dict>
    </array>

    <!-- MWDAT: Meta Wearables Device Access Toolkit 設定 -->
    <key>MWDAT</key>
    <dict>
        <key>MetaAppID</key>
        <string>4225976931002254</string>
        <key>Analytics</key>
        <dict>
            <key>OptOut</key>
            <true/>
        </dict>
        <key>AppLinkURLScheme</key>
        <string>https://kojiokazaki.github.io/dat-link/</string>
    </dict>

    <!-- カメラ使用の説明 (Privacy) -->
    <key>NSCameraUsageDescription</key>
    <string>Ray-Ban Meta グラスのカメラストリームを受信するために使用します</string>

    <!-- Bluetooth 使用の説明 -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Ray-Ban Meta グラスと接続するために使用します</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>Ray-Ban Meta グラスと通信するために使用します</string>

    <!-- LSApplicationQueriesSchemes -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>fb-metaai</string>
    </array>

    <!-- Scene Manifest (SwiftUI) -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>

    <!-- Launch Screen -->
    <key>UILaunchScreen</key>
    <dict/>

    <!-- 画面方向 -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Indirect Input Events -->
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
</dict>
</plist>
